[{"id":"86b4d215caa302a6","type":"subflow","name":"Luz Presença","info":"","category":"","in":[{"x":60,"y":100,"wires":[{"id":"f684bf272302f154"}]}],"out":[{"x":600,"y":60,"wires":[{"id":"f684bf272302f154","port":0}]},{"x":600,"y":140,"wires":[{"id":"f684bf272302f154","port":1}]},{"x":600,"y":220,"wires":[{"id":"f684bf272302f154","port":2}]}],"env":[{"name":"input_entidade","type":"str","value":""},{"name":"lux_entidade","type":"str","value":""},{"name":"lux_min","type":"num","value":""},{"name":"lux_max","type":"num","value":""},{"name":"lux_max_manual","type":"num","value":""},{"name":"t_max_on_m","type":"num","value":""},{"name":"t_off_s","type":"num","value":""},{"name":"t_offset_por_sol","type":"num","value":""},{"name":"t_offset_nascer_sol","type":"num","value":""},{"name":"desativa_entidade","type":"str","value":""},{"name":"desativa_entidade2","type":"str","value":""},{"name":"desativa_entidade3","type":"str","value":""},{"name":"desativa_lux_manual","type":"str","value":""},{"name":"dbg","type":"bool","value":"false"}],"meta":{},"color":"#DDAA99"},{"id":"f684bf272302f154","type":"function","z":"86b4d215caa302a6","name":"function","func":"/**\n * PIR Intermediário (equilíbrio entre simples e inteligente)\n *\n * ENTRADA PRINCIPAL:\n * - msg.payload: \"on\" / \"off\"  (PIR)\n *\n * OPCIONAL:\n * - msg.lux (number)\n * - msg.desativa (bool)\n * - msg.manual (true)\n *\n * SAÍDA:\n * [0] ON\n * [1] OFF\n * [2] DEBUG\n */\n\nconst cfg = {\n  lux_min: Number(env.get('lux_min') || 0),\n  lux_max: Number(env.get('lux_max') || 0),\n  lux_max_manual: Number(env.get('lux_max_manual') || 0),\n\n  t_off_s: Number(env.get('t_off_s') || 30),\n  t_max_on_m: Number(env.get('t_max_on_m') || 60),\n\n  pending_pir_ms: 120000,\n  dbg: String(env.get('dbg')) === 'true'\n};\n\n// ================= STATE =================\nlet state = context.get('state') || {\n  light_on: false,\n  mode: 'off', // off | pir | manual\n  lux: null,\n  disabled: false,\n\n  pir_active: false,\n  last_pir: 0,\n  pending_pir: false\n};\n\nlet timers = context.get('timers') || {};\n\n// ================= HELPERS =================\nfunction log(...args) {\n  if (!cfg.dbg) return;\n  node.send([null, null, { payload: args.join(' ') }]);\n}\n\nfunction save() {\n  context.set('state', state);\n  context.set('timers', timers);\n}\n\nfunction clearTimer(name) {\n  if (timers[name]) clearTimeout(timers[name]);\n  delete timers[name];\n}\n\nfunction setTimer(name, ms, fn) {\n  clearTimer(name);\n  timers[name] = setTimeout(fn, ms);\n}\n\n// ================= ACTIONS =================\nfunction turnOn(reason) {\n  state.light_on = true;\n  state.mode = 'pir';\n  state.pending_pir = false;\n\n  clearTimer('off');\n  setTimer('max_on', cfg.t_max_on_m * 60000, () => turnOff('max_on'));\n\n  node.send([{ payload: 'on', reason }, null, null]);\n  log('ON', reason);\n}\n\nfunction turnOff(reason) {\n  state.light_on = false;\n  state.mode = 'off';\n\n  clearTimer('off');\n  clearTimer('max_on');\n\n  node.send([null, { payload: 'off', reason }, null]);\n  log('OFF', reason);\n}\n\n// ================= LUX =================\nif (msg.lux !== undefined) {\n  state.lux = Number(msg.lux);\n\n  // desligar por excesso de luz\n  if (state.light_on) {\n    if (state.mode === 'pir' && cfg.lux_max && state.lux >= cfg.lux_max) {\n      setTimer('off', cfg.t_off_s * 1000, () => turnOff('lux_max'));\n    }\n\n    if (\n      state.mode === 'manual' &&\n      cfg.lux_max_manual &&\n      state.lux >= cfg.lux_max_manual\n    ) {\n      setTimer('off', cfg.t_off_s * 1000, () => turnOff('lux_manual'));\n    }\n  }\n\n  // pending_pir → ativar quando escurecer\n  if (\n    state.pending_pir &&\n    state.pir_active &&\n    !state.light_on &&\n    cfg.lux_min &&\n    state.lux < cfg.lux_min &&\n    Date.now() - state.last_pir < cfg.pending_pir_ms\n  ) {\n    turnOn('pending_lux');\n  }\n\n  save();\n  return;\n}\n\n// ================= DESATIVA =================\nif (msg.desativa !== undefined) {\n  state.disabled = !!msg.desativa;\n\n  if (state.disabled && state.light_on && state.mode === 'pir') {\n    setTimer('off', cfg.t_off_s * 1000, () => turnOff('disabled'));\n  }\n\n  save();\n  return;\n}\n\n// ================= MANUAL =================\nif (msg.manual === true) {\n  state.light_on = true;\n  state.mode = 'manual';\n\n  clearTimer('off');\n  clearTimer('max_on');\n\n  log('MANUAL ON');\n  save();\n  return;\n}\n\n// ================= PIR =================\nif (msg.payload === 'on') {\n  state.pir_active = true;\n  state.last_pir = Date.now();\n\n  if (state.mode === 'manual') return;\n  if (state.disabled) return;\n\n  // bloqueio por luz\n  if (cfg.lux_min && state.lux !== null && state.lux >= cfg.lux_min) {\n    state.pending_pir = true;\n    log('PENDING (lux alto)');\n    save();\n    return;\n  }\n\n  if (!state.light_on) {\n    turnOn('pir');\n  }\n\n  clearTimer('off');\n}\n\nif (msg.payload === 'off') {\n  state.pir_active = false;\n\n  if (state.mode === 'manual') return;\n\n  setTimer('off', cfg.t_off_s * 1000, () => turnOff('pir_timeout'));\n}\n\nsave();\nreturn;","outputs":3,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":320,"y":100,"wires":[[],[],[]]},{"id":"5e177bd3655f8799","type":"server-state-changed","z":"86b4d215caa302a6","name":"","server":"12097a98.a70645","version":6,"outputs":1,"exposeAsEntityConfig":"","entities":{"entity":["${lux_entidade}"],"substring":[],"regex":[]},"outputInitially":true,"stateType":"str","ifState":"","ifStateType":"str","ifStateOperator":"is","outputOnlyOnStateChange":true,"for":"0","forType":"num","forUnits":"minutes","ignorePrevStateNull":false,"ignorePrevStateUnknown":false,"ignorePrevStateUnavailable":false,"ignoreCurrentStateUnknown":false,"ignoreCurrentStateUnavailable":false,"outputProperties":[{"property":"lux","propertyType":"msg","value":"number","valueType":"entityState"}],"x":170,"y":300,"wires":[["f684bf272302f154"]]},{"id":"d7aa3387c5f91102","type":"server-state-change