[{"id":"86b4d215caa302a6","type":"subflow","name":"Luz Presença","info":"","category":"","in":[{"x":60,"y":100,"wires":[{"id":"f684bf272302f154"}]}],"out":[{"x":600,"y":60,"wires":[{"id":"f684bf272302f154","port":0}]},{"x":600,"y":140,"wires":[{"id":"f684bf272302f154","port":1}]},{"x":600,"y":220,"wires":[{"id":"f684bf272302f154","port":2}]}],"env":[{"name":"input_entidade","type":"str","value":""},{"name":"lux_entidade","type":"str","value":""},{"name":"lux_min","type":"num","value":""},{"name":"lux_max","type":"num","value":""},{"name":"lux_max_manual","type":"num","value":""},{"name":"t_max_on_m","type":"num","value":""},{"name":"t_off_s","type":"num","value":"60"},{"name":"t_max_manual_m","type":"num","value":"240"},{"name":"t_manual_ignora_s","type":"num","value":"15"},{"name":"t_offset_por_sol","type":"num","value":""},{"name":"t_offset_nascer_sol","type":"num","value":""},{"name":"desativa_entidade","type":"str","value":""},{"name":"desativa_entidade2","type":"str","value":""},{"name":"desativa_entidade3","type":"str","value":""},{"name":"desativa_lux_manual","type":"str","value":""},{"name":"dbg","type":"bool","value":"false"}],"meta":{},"color":"#DDAA99","icon":"node-red/feed.svg"},{"id":"f684bf272302f154","type":"function","z":"86b4d215caa302a6","name":"function","func":"/**\n * Luz Presença - controlador PIR / Lux para Node-RED\n * COM LOGS AVANÇADOS DE DIAGNÓSTICO\n *\n * Atualizações Recentes:\n * - Tratamento Seguro de Variáveis Vazias.\n * - Correção de PIR OFF com `t_off_s`.\n * - Correção de Conflito de Timers no Lux.\n * - Proteção de Boot (Deploy).\n * - Implementação do lux_min (Histerese): Agora o `lux_min` é usado\n *   corretamente para bloquear o acendimento. O `lux_max` atua apenas \n *   para desligar uma luz que já está acesa.\n */\n\nconst getNum = (key, def) => {\n  const v = env.get(key);\n  return (v === undefined || v === null || String(v).trim() === '') ? def : Number(v);\n};\n\nconst cfg = {\n  lux_min: getNum('lux_min', 0),\n  lux_max: getNum('lux_max', 0),\n  lux_max_manual: getNum('lux_max_manual', 0),\n  t_off_s: getNum('t_off_s', 30),\n  t_max_on_m: getNum('t_max_on_m', 0),\n  t_max_manual_m: getNum('t_max_manual_m', 0),\n  t_manual_ignora_s: getNum('t_manual_ignora_s', 0),\n  dbg: true, \n  ent_d1: (env.get('desativa_entidade') || '').trim(),\n  ent_d2: (env.get('desativa_entidade2') || '').trim(),\n  ent_d3: (env.get('desativa_entidade3') || '').trim(),\n  ent_d_lux: (env.get('desativa_lux_manual') || '').trim()\n};\n\n// PROTEÇÃO DE BOOT\nlet is_init = context.get('is_init');\nif (is_init === undefined) {\n  is_init = true;\n  context.set('is_init', true);\n  log('[boot] Nó inicializado/reimplantado. Janela de recuperação de 5s ativada.');\n  setTimeout(() => {\n    context.set('is_init', false);\n    log('[boot] Janela de inicialização encerrada. Operação normal.');\n  }, 5000);\n}\n\nlet state = context.get('state') || {\n  light_on: false,\n  mode: 'off',\n  lux: null,\n  pir_active: false,\n  last_pir: 0,\n  pending_pir: false,\n  manual_ignore_until: 0,\n  auto_on_until: 0,\n  auto_off_until: 0\n};\n\nlet timers = context.get('timers') || {};\n\nconst bool = v => typeof v === 'boolean' ? v\n  : typeof v === 'number' ? v !== 0\n  : typeof v === 'string' ? ['true','on','yes','y','home','open','1'].includes(v.trim().toLowerCase())\n  : !!v;\n\nfunction save() {\n  context.set('state', state);\n  context.set('timers', timers);\n}\n\nfunction log(s) {\n  if (cfg.dbg) node.send([null, null, { payload: s }]);\n}\n\nfunction getHaStateDebug(entityId, label) {\n  if (!entityId) return false;\n  \n  const ha = global.get('homeassistant');\n  if (!ha) {\n    log(`[DIAGNÓSTICO ${label}] ERRO FATAL: Cache global não existe!`);\n    return false;\n  }\n  \n  const servers = Object.keys(ha);\n  for (const srv of servers) {\n    if (ha[srv] && ha[srv].states && ha[srv].states[entityId]) {\n      return bool(ha[srv].states[entityId].state);\n    }\n  }\n  return false;\n}\n\nfunction dbgState(prefix) {\n  const ignore = state.manual_ignore_until\n    ? Math.max(0, Math.ceil((state.manual_ignore_until - Date.now()) / 1000)) + 's'\n    : '0s';\n\n  log(\n    `${prefix} | mode=${state.mode} light_on=${state.light_on} pir_active=${state.pir_active} ` +\n    `lux=${state.lux ?? 'null'} pending=${state.pending_pir} ignore=${ignore}`\n  );\n}\n\nfunction clearT(n) {\n  if (timers[n]) {\n    clearTimeout(timers[n]);\n    delete timers[n];\n  }\n}\n\nfunction setT(n, ms, fn, why) {\n  clearT(n);\n  timers[n] = setTimeout(fn, ms);\n  log(`[timer] ${n} em ${Math.max(1, Math.round(ms / 1000))}s${why ? ` (${why})` : ''}`);\n}\n\nfunction mode(m, why) {\n  if (state.mode !== m) {\n    log(`[mode] ${state.mode} -> ${m}${why ? ` (${why})` : ''}`);\n    state.mode = m;\n  }\n}\n\nfunction activeDisableFlags() {\n  const actives = [];\n  if (cfg.ent_d1 && getHaStateDebug(cfg.ent_d1, 'D1')) actives.push('desativa1');\n  if (cfg.ent_d2 && getHaStateDebug(cfg.ent_d2, 'D2')) actives.push('desativa2');\n  if (cfg.ent_d3 && getHaStateDebug(cfg.ent_d3, 'D3')) actives.push('desativa3');\n  return actives;\n}\n\nfunction luxManualBlocked() {\n  return cfg.ent_d_lux ? getHaStateDebug(cfg.ent_d_lux, 'D_LUX') : false;\n}\n\nfunction turnOn(reason) {\n  log(`[on] Verificando flags e lux antes de ligar...`);\n  const actives = activeDisableFlags();\n  \n  if (actives.length > 0) {\n    log(`[on] BLOQUEADO por flags: ${actives.join(', ')} (${reason})`);\n    dbgState('[state]');\n    save();\n    return;\n  }\n\n  // Verifica o lux_min para permitir acender (ou usa o lux_max se lux_min for zero)\n  const thresholdOn = cfg.lux_min > 0 ? cfg.lux_min : cfg.lux_max;\n\n  if (reason === 'pir' && thresholdOn > 0 && state.lux !== null && state.lux >= thresholdOn) {\n    if (!luxManualBlocked()) {\n      log(`[on] BLOQUEADO por claridade (lux=${state.lux} >= min=${thresholdOn})`);\n      state.pending_pir = true;\n      dbgState('[state]');\n      save();\n      return;\n    } else {\n      log(`[on] Claridade ignorada pela flag desativa_lux_manual.`);\n    }\n  }\n\n  state.light_on = true;\n  state.pending_pir = false;\n  state.auto_on_until = Date.now() + 1500;\n  mode('pir', reason);\n\n  clearT('off');\n  clearT('max_on');\n\n  if (cfg.t_max_on_m > 0) {\n    setT('max_on', cfg.t_max_on_m * 60000, () => turnOff('max_on', false), 'tempo máximo PIR');\n  }\n\n  node.send([{ payload: 'on', reason }, null, null]);\n  log(`[on] luz ligada (${reason})`);\n  dbgState('[state]');\n  save();\n\n  if (state.lux !== null) {\n    handleLux(state.lux);\n  }\n}\n\nfunction turnOff(reason, fromManual) {\n  state.light_on = false;\n  state.pending_pir = false;\n  state.auto_off_until = Date.now() + 2000;\n  mode('off', reason);\n\n  clearT('off');\n  clearT('max_on');\n  clearT('manual_max');\n\n  if (fromManual) {\n    state.manual_ignore_until = cfg.t_manual_ignora_s > 0\n      ? Date.now() + cfg.t_manual_ignora_s * 1000\n      : 0;\n  }\n\n  node.send([null, { payload: 'off', reason }, null]);\n  log(`[off] luz desligada (${reason})`);\n  dbgState('[state]');\n  save();\n}\n\nfunction handleLightState(s) {\n  const now = Date.now();\n\n  if (s === 'on') {\n    if (state.auto_on_until && now <= state.auto_on_until) {\n      log('[light_state auto on ignored]');\n      dbgState('[state]');\n      save();\n      return;\n    }\n\n    if (is_init) {\n      log('[boot] Luz ligada detectada durante inicialização -> assumindo modo PIR (recuperação).');\n      state.light_on = true;\n      state.pending_pir = false;\n      mode('pir', 'boot');\n      clearT('off');\n      clearT('max_on');\n\n      if (cfg.t_off_s > 0) {\n        setT('off', cfg.t_off_s * 1000, () => turnOff('pir_timeout', false), 'recuperação de deploy');\n      }\n      dbgState('[state]');\n      save();\n      return;\n    }\n\n    state.light_on = true;\n    state.pending_pir = false;\n    mode('manual', 'entity on');\n    clearT('off');\n    clearT('max_on');\n\n    if (cfg.t_max_manual_m > 0) {\n      setT('manual_max', cfg.t_max_manual_m * 60000, () => turnOff('manual_timeout', false), 'tempo máximo manual');\n    }\n\n    log('[manual] entidade ligada -> modo manual');\n    dbgState('[state]');\n    save();\n\n    if (state.lux !== null) {\n      handleLux(state.lux);\n    }\n    return;\n  }\n\n  if (s === 'off') {\n    if (state.auto_off_until && now <= state.auto_off_until) {\n      log('[light_state auto off ignored]');\n      dbgState('[state]');\n      save();\n      return;\n    }\n\n    state.light_on = false;\n    state.pending_pir = false;\n    mode('off', 'entity off');\n\n    clearT('off');\n    clearT('max_on');\n    clearT('manual_max');\n\n    state.manual_ignore_until = cfg.t_manual_ignora_s > 0\n      ? now + cfg.t_manual_ignora_s * 1000\n      : 0;\n\n    log(`[manual] entidade desligada -> ignorar PIR por ${cfg.t_manual_ignora_s}s`);\n    dbgState('[state]');\n    save();\n  }\n}\n\nfunction handleLux(v) {\n  const lux = Number(v);\n  if (isNaN(lux)) return;\n  state.lux = lux;\n\n  const blockedByFlag = luxManualBlocked();\n  const thresholdOn = cfg.lux_min > 0 ? cfg.lux_min : cfg.lux_max;\n\n  // Ligar a luz caso esteja pendente e a luminosidade baixe o suficiente\n  if (!state.light_on && state.pending_pir && state.pir_active && thresholdOn > 0 && lux < thresholdOn) {\n    log(`[lux] Luminosidade baixou (${lux} < min=${thresholdOn}) com presença ativa -> ligando luz`);\n    turnOn('pir');\n    return;\n  }\n\n  if (state.light_on && state.mode === 'pir' && cfg.lux_max > 0) {\n    if (lux >= cfg.lux_max) {\n      if (blockedByFlag) {\n        log(`[lux_max] ${lux} >= max=${cfg.lux_max}, mas IGNORADO pois a flag desativa_lux está ATIVA.`);\n        save();\n        return;\n      }\n      if (!timers['off']) {\n        log(`[lux_max] ${lux} >= max=${cfg.lux_max} -> off em ${cfg.t_off_s}s`);\n        setT('off', cfg.t_off_s * 1000, () => turnOff('lux_max', false), 'lux_max');\n        dbgState('[state]');\n      }\n    } else if (timers['off'] && state.pir_active) { \n      log(`[lux_max] Luminosidade baixou para ${lux} -> CANCELANDO desligamento por lux`);\n      clearT('off');\n    }\n    save();\n    return;\n  }\n\n  if (state.light_on && state.mode === 'manual' && cfg.lux_max_manual > 0) {\n    if (lux >= cfg.lux_max_manual) {\n      if (blockedByFlag) {\n        log(`[lux_max_manual] ${lux} >= manual_max=${cfg.lux_max_manual}, mas IGNORADO pois a flag desativa_lux está ATIVA.`);\n        save();\n        return;\n      }\n      if (!timers['off']) {\n        log(`[lux_max_manual] ${lux} >= manual_max=${cfg.lux_max_manual} -> off em ${cfg.t_off_s}s`);\n        setT('off', cfg.t_off_s * 1000, () => turnOff('lux_max_manual', false), 'lux_max_manual');\n        dbgState('[state]');\n      }\n    } else if (timers['off']) {\n      log(`[lux_max_manual] Luminosidade baixou para ${lux} -> CANCELANDO desligamento manual por lux`);\n      clearT('off');\n    }\n    save();\n    return;\n  }\n\n  save();\n}\n\nfunction handlePirOn() {\n  const now = Date.now();\n\n  if (state.manual_ignore_until && now < state.manual_ignore_until) {\n    log(`[pir:on] ignorado (${Math.ceil((state.manual_ignore_until - now) / 1000)}s)`);\n    dbgState('[state]');\n    save();\n    return;\n  }\n\n  state.pir_active = true;\n  state.last_pir = now;\n\n  if (state.mode === 'manual') {\n    log('[pir:on] ignorado em manual');\n    dbgState('[state]');\n    save();\n    return;\n  }\n\n  if (!state.light_on) {\n    turnOn('pir');\n    return;\n  }\n\n  clearT('off');\n  dbgState('[state]');\n  save();\n}\n\nfunction handlePirOff() {\n  const now = Date.now();\n\n  if (state.manual_ignore_until && now < state.manual_ignore_until) {\n    log(`[pir:off] ignorado (${Math.ceil((state.manual_ignore_until - now) / 1000)}s)`);\n    dbgState('[state]');\n    save();\n    return;\n  }\n\n  state.pir_active = false;\n  state.pending_pir = false; \n\n  if (!state.light_on) {\n    dbgState('[state]');\n    save();\n    return;\n  }\n\n  if (state.mode === 'manual') {\n    log('[pir:off] ignorado em modo manual');\n    dbgState('[state]');\n    save();\n    return;\n  }\n\n  if (cfg.t_off_s > 0) {\n    setT('off', cfg.t_off_s * 1000, () => turnOff('pir_timeout', false), 'ausência de movimento');\n    dbgState('[state]');\n  } else {\n    turnOff('pir_timeout', false);\n  }\n  \n  save();\n}\n\nif (msg.light_state !== undefined) { handleLightState(String(msg.light_state).toLowerCase()); return; }\nif (msg.lux !== undefined) { handleLux(msg.lux); return; }\nif (msg.payload === 'on') { handlePirOn(); return; }\nif (msg.payload === 'off') { handlePirOff(); return; }\n\nsave();\nreturn;","outputs":3,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":320,"y":100,"wires":[[],[],[]]},{"id":"5e177bd3655f8799","type":"server-state-changed","z":"86b4d215caa302a6","name":"","server":"12097a98.a70645","version":6,"outputs":1,"exposeAsEntityConfig":"","entities":{"entity":["${lux_entidade}"],"substring":[],"regex":[]},"outputInitially":true,"stateType":"str","ifState":"","ifStateType":"str","ifStateOperator":"is","outputOnlyOnStateChange":true,"for":"0","forType":"num","forUnits":"minutes","ignorePrevStateNull":false,"ignorePrevStateUnknown":false,"ignorePrevStateUnavailable":false,"ignoreCurrentStateUnknown":false,"ignoreCurrentStateUnavailable":false,"outputProperties":[{"property":"lux","propertyType":"msg","value":"number","valueType":"entityState"}],"x":170,"y":260,"wires":[["f684bf272302f154"]]},{"id":"ebf317f0e3f8f3f2","type":"server-state-changed","z":"86b4d215caa302a6","name":"","server":"12097a98.a70645","version":6,"outputs":1,"exposeAsEntityConfig":"","entities":{"entity":["${input_entidade}"],"substring":[],"regex":[]},"outputInitially":true,"stateType":"str","ifState":"","ifStateType":"str","ifStateOperator":"is","outputOnlyOnStateChange":true,"for":"0","forType":"num","forUnits":"minutes","ignorePrevStateNull":false,"ignorePrevStateUnknown":false,"ignorePrevStateUnavailable":false,"ignor